# Apify - use a scoped/free-tier account token, not one tied to a paid account
APIFY_TOKEN=
APIFY_META_ADS_ACTOR=apify/facebook-ads-scraper

# OpenRouter (LLM provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Video rendering - set ONE of these depending on which path you go with
OPENMONTAGE_REPO_PATH=
REMOTION_PROJECT_PATH=

# Telegram (only needed if using the standalone telegram_bot.py fallback;
# if running through Hermes's native gateway instead, configure it there)
TELEGRAM_BOT_TOKEN=
