# Apify - use a scoped/free-tier account token, not one tied to a paid account
APIFY_TOKEN=
APIFY_META_ADS_ACTOR=automly/facebook-ad-library-scraper

# LLM provider - defaults to OpenRouter's free auto-router (no payment needed).
# Both ads_manager.py and script_agent.py read these three variables.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free

# Alternative: NVIDIA build.nvidia.com (also permitted by the brief).
# Uncomment these and comment out the OpenRouter ones above to switch.
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=
# LLM_MODEL=meta/llama-3.3-70b-instruct

# Video rendering - Remotion project path (see video-render/ or your
# equivalent folder name in this repo)
REMOTION_PROJECT_PATH=

# OpenMontage alternative (not used by default - see agents/video_agent.py
# docstring for why Remotion was chosen instead)
OPENMONTAGE_REPO_PATH=

# Telegram - only needed if using the standalone telegram_bot.py fallback.
# If running through Hermes's native gateway instead, the bot token is
# configured separately via `hermes gateway setup`, not here.
TELEGRAM_BOT_TOKEN=
